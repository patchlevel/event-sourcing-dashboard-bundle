{% extends '@PatchlevelEventSourcingDashboard/layout.html.twig' %}
{% import '@PatchlevelEventSourcingDashboard/components.html.twig' as ui %}

{% block title %}{{ aggregateName }} · Inspection · {% endblock %}

{% block content %}
    {% set base = { aggregateId: aggregateId, aggregateName: aggregateName, tab: tab } %}

    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
            {{ ui.title('Inspection') }}
            <p class="mt-1 flex flex-wrap items-center gap-x-2 text-sm text-gray-400 light:text-slate-500">
                <span class="font-medium text-gray-200 light:text-slate-700">{{ aggregateName }}</span>
                <span class="group/parent font-mono text-xs">{{ aggregateId }} {{ ui.clipboard(aggregateId) }}</span>
            </p>
        </div>
        {% if until %}
            {{ ui.link_secondary(path('patchlevel_event_sourcing_dashboard_inspection_show', base), 'Stop time travel', 'stop', 'Back to the current state') }}
        {% else %}
            {{ ui.link_primary(path('patchlevel_event_sourcing_dashboard_inspection_show', base|merge({ until: 1 })) ~ '#1', 'Time travel', 'clock', 'Replay the aggregate event by event') }}
        {% endif %}
    </div>

    <div class="mt-8 grid items-start gap-6 lg:grid-cols-2">
        <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 lg:sticky lg:top-6 light:border-slate-200 light:bg-white light:shadow-sm">
            {% if until %}
                {# The one loud surface on the page: the brand gradient says "you are not looking at now". #}
                <div class="flex flex-wrap items-center justify-between gap-3 bg-gradient-to-r from-secondary to-primary px-5 py-3 text-white">
                    <div class="flex items-center gap-2 text-sm">
                        {{ heroicon('clock', 'h-4 w-4') }}
                        <span class="font-semibold">Time travel</span>
                        <span class="font-mono text-xs tabular-nums text-blue-100">playhead {{ aggregate.playhead }} of {{ count }}</span>
                    </div>
                    <div class="flex gap-1.5">
                        {{ _self.travel(aggregate.playhead != 1 ? path('patchlevel_event_sourcing_dashboard_inspection_show', base|merge({ until: until - 1 })) ~ '#' ~ (until - 1) : null, 'backward', 'One event back') }}
                        {{ _self.travel(path('patchlevel_event_sourcing_dashboard_inspection_show', base), 'stop', 'Stop time travel') }}
                        {{ _self.travel(aggregate.playhead < count ? path('patchlevel_event_sourcing_dashboard_inspection_show', base|merge({ until: until + 1 })) ~ '#' ~ (until + 1) : null, 'forward', 'One event forward') }}
                    </div>
                </div>
            {% endif %}

            <nav class="flex gap-1 border-b border-slate-800 px-3 light:border-slate-200" aria-label="Aggregate views">
                {% for key, label in { details: 'Details', serialized: 'Serialized', dump: 'Dump', snapshot: 'Snapshot' } %}
                    <a href="{{ path('patchlevel_event_sourcing_dashboard_inspection_show', base|merge({ tab: key, until: until })) }}{% if until %}#{{ until }}{% endif %}"
                       {% if key == tab %}aria-current="page"{% endif %}
                       class="{{ key == tab ? 'border-primary-light text-white light:text-slate-900' : 'border-transparent text-gray-400 hover:border-slate-600 hover:text-white light:text-slate-500 light:hover:border-slate-300 light:hover:text-slate-900' }} -mb-px border-b-2 px-3 py-3 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-light">
                        {{ label }}
                    </a>
                {% endfor %}
            </nav>

            <div class="p-5">
                {% if tab == 'details' %}
                    <dl class="divide-y divide-slate-800 light:divide-slate-100">
                        {{ ui.dl_row('ID', aggregateId, true) }}
                        {{ ui.dl_row('Name', aggregateName) }}
                        {{ ui.dl_row('Class', aggregateClass, true) }}
                        {{ ui.dl_row('Playhead', aggregate.playhead, true) }}
                        {% if metadata.snapshot %}
                            {{ ui.dl_row('Snapshot adapter', metadata.snapshot.store) }}
                            {{ ui.dl_row('Snapshot version', metadata.snapshot.version, true) }}
                            {{ ui.dl_row('Snapshot batch', metadata.snapshot.batch, true) }}
                        {% endif %}
                    </dl>
                {% elseif tab == 'dump' %}
                    {{ eventsourcing_dump(aggregate) }}
                {% elseif tab == 'serialized' %}
                    {% if serializedError %}
                        {{ ui.error(serializedError) }}
                    {% endif %}
                    {% if serializedAggregate %}
                        <div class="json">
                            {{- serializedAggregate -}}
                        </div>
                    {% endif %}
                {% elseif tab == 'snapshot' %}
                    {% if snapshotError %}
                        {{ ui.error(snapshotError) }}
                    {% endif %}
                    {% if snapshot %}
                        {{ eventsourcing_dump(snapshot) }}
                    {% elseif not snapshotError %}
                        {{ ui.empty('document-magnifying-glass', 'No snapshot stored', 'This aggregate is rebuilt from its events every time.') }}
                    {% endif %}
                {% endif %}
            </div>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5 light:border-slate-200 light:bg-white light:shadow-sm">
            <h2 class="mb-5 text-sm font-semibold text-white light:text-slate-900">
                Event history <span class="ml-1 font-mono text-xs font-normal tabular-nums text-gray-500">{{ count }}</span>
            </h2>

            <ol role="list" class="relative">
                {% for message in messages %}
                    {% set playhead = eventsourcing_playhead(message) %}
                    {% set color = eventsourcing_inspection_color(message.event) %}
                    {% set future = until and loop.index > until %}
                    {% set dialog = 'message-' ~ loop.index %}
                    <li class="group/message relative flex gap-4 pb-6 {{ future ? 'opacity-40 saturate-0' }} {{ loop.index == count ? 'pb-0' }}">
                        <span id="{{ loop.index }}" class="absolute -top-24" aria-hidden="true"></span>
                        <span id="marker-{{ loop.index }}" class="invisible absolute -left-9 top-1 text-primary-light" aria-hidden="true">
                            {{ heroicon('arrow-long-right', 'h-6 w-6') }}
                        </span>

                        {% if loop.index != count %}
                            <span class="absolute left-4 top-8 -ml-px h-full w-0.5 bg-slate-800 light:bg-slate-200" aria-hidden="true"></span>
                        {% endif %}

                        <span class="relative flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-600 text-white light:bg-slate-400" {% if color %}style="background: {{ color }};"{% endif %} aria-hidden="true">
                            {{ heroicon(eventsourcing_inspection_icon(message.event, 'calendar'), 'h-4 w-4') }}
                        </span>

                        <div class="flex min-w-0 flex-1 flex-col gap-1 pt-1.5 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                            <div class="min-w-0 break-words text-sm text-gray-200 light:text-slate-700">
                                {{ eventsourcing_inspection_description(message.event, eventsourcing_event_name(message)) }}
                                <span class="ml-1 inline-flex gap-0.5 align-middle opacity-0 transition-opacity focus-within:opacity-100 group-hover/message:opacity-100">
                                    <button type="button" data-modal="{{ dialog }}" title="Show message details" aria-label="Show message details"
                                            class="rounded p-0.5 text-gray-500 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light light:hover:text-slate-900">
                                        {{ heroicon('magnifying-glass', 'h-4 w-4') }}
                                    </button>
                                    <a href="{{ path('patchlevel_event_sourcing_dashboard_inspection_show', base|merge({ until: playhead })) }}#{{ playhead }}" title="Travel to this event" aria-label="Travel to this event"
                                       class="rounded p-0.5 text-gray-500 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light light:hover:text-slate-900">
                                        {{ heroicon('play-pause', 'h-4 w-4') }}
                                    </a>
                                </span>

                                {% embed '@PatchlevelEventSourcingDashboard/dialog.html.twig' with { id: dialog, title: eventsourcing_event_name(message), message: message } %}
                                    {% block content %}
                                        {{ include('@PatchlevelEventSourcingDashboard/store/detail.html.twig', { message: message }) }}
                                    {% endblock %}
                                {% endembed %}
                            </div>
                            <div class="flex shrink-0 gap-2 font-mono text-xs tabular-nums text-gray-500 sm:flex-col sm:items-end sm:gap-0">
                                <span>{{ eventsourcing_recorded_on(message) ? eventsourcing_recorded_on(message)|date('Y-m-d H:i:s') : '-' }}</span>
                                <span class="text-gray-600 light:text-slate-400">#{{ playhead }}</span>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </div>
{% endblock %}

{% macro travel(url, icon, label) %}
    {% if url %}
        <a href="{{ url }}" title="{{ label }}" aria-label="{{ label }}"
           class="rounded-md bg-white p-1.5 text-primary transition-colors hover:bg-blue-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
            {{ heroicon(icon, 'h-4 w-4') }}
        </a>
    {% else %}
        <span class="rounded-md p-1.5 text-blue-200" aria-hidden="true">{{ heroicon(icon, 'h-4 w-4') }}</span>
    {% endif %}
{% endmacro %}
