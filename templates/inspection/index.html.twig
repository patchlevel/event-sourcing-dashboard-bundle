{% extends '@PatchlevelEventSourcingDashboard/layout.html.twig' %}
{% import '@PatchlevelEventSourcingDashboard/components.html.twig' as ui %}

{% block title %}Inspection · {% endblock %}

{% block content %}
    {{ ui.title('Inspection') }}
    {{ ui.subtitle('Pick an aggregate to see its state, its event history and travel back in time.') }}

    <div class="mt-8 max-w-md rounded-2xl border border-slate-800 bg-slate-900 p-6 light:border-slate-200 light:bg-white light:shadow-sm sm:p-8">
        <form class="space-y-5" method="POST" action="{{ path('patchlevel_event_sourcing_dashboard_inspection_index') }}">
            <div>
                {{ ui.label('aggregate', 'Aggregate') }}
                {{ ui.select('aggregate', aggregates, app.request.query.get('aggregate'), {}, true, 'Choose an aggregate') }}
            </div>
            <div>
                {{ ui.label('aggregateId', 'Aggregate ID') }}
                {{ ui.input('aggregateId', app.request.query.get('aggregateId'), '018d233e-7906-73f1-8a0c-f76a4fdac34e', true) }}
            </div>
            <div class="pt-1">
                {{ ui.button_primary('Inspect', 'identification') }}
            </div>
        </form>
    </div>
{% endblock %}
