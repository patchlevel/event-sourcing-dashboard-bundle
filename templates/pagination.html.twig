{% set total = count == 0 ? 1 : (count / limit)|round(0, 'ceil') %}
{% set between = 2 %}
{% set route = app.request.attributes.get('_route') %}
{% set query = app.request.query.all %}
{% set link = 'inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light' %}
{% set idle = 'text-gray-400 hover:bg-slate-800 hover:text-white light:text-slate-600 light:hover:bg-slate-100 light:hover:text-slate-900' %}
{% set disabled = 'pointer-events-none text-gray-600 light:text-slate-300' %}

<nav class="flex items-center justify-between gap-4 border-t border-slate-800 px-4 py-3 light:border-slate-200" aria-label="Pagination">
    <a href="{{ path(route, query|merge({ page: page - 1 })) }}"
       class="{{ link }} {{ page <= 1 ? disabled : idle }}" {% if page <= 1 %}aria-disabled="true" tabindex="-1"{% endif %}>
        {{ heroicon('chevron-left', 'h-4 w-4') }} Previous
    </a>

    <div class="hidden items-center gap-1 md:flex">
        {% for p in 1..total %}
            {% if loop.first or loop.last or (p >= page - between and p <= page + between) %}
                <a href="{{ path(route, query|merge({ page: p })) }}" {% if p == page %}aria-current="page"{% endif %}
                   class="{{ link }} font-mono tabular-nums {{ p == page ? 'bg-blue-950 light:bg-blue-50 text-primary-light' : idle }}">{{ p }}</a>
            {% endif %}

            {% if (p == 2 and page - between > 2) or (p == total - 1 and page + between < total - 1) %}
                <span class="px-1 text-sm text-gray-500" aria-hidden="true">…</span>
            {% endif %}
        {% endfor %}
    </div>
    <div class="font-mono text-xs tabular-nums text-gray-500 md:hidden">{{ page }} / {{ total }}</div>

    <a href="{{ path(route, query|merge({ page: page + 1 })) }}"
       class="{{ link }} {{ page >= total ? disabled : idle }}" {% if page >= total %}aria-disabled="true" tabindex="-1"{% endif %}>
        Next {{ heroicon('chevron-right', 'h-4 w-4') }}
    </a>
</nav>
