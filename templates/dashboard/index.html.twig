{% extends '@PatchlevelEventSourcingDashboard/layout.html.twig' %}
{% import '@PatchlevelEventSourcingDashboard/components.html.twig' as ui %}

{% block title %}Dashboard · {% endblock %}

{% block content %}
    {{ ui.title('Dashboard') }}
    {{ ui.subtitle('Your event sourcing setup at a glance.') }}

    {# One strip, four cells: the numbers read as one system, not four widgets. #}
    <div class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-slate-800 bg-slate-800 sm:grid-cols-2 lg:grid-cols-4 light:border-slate-200 light:bg-slate-200 light:shadow-sm">
        {{ _self.stat('Events in store', messageCount, 'circle-stack', 'bg-blue-950 light:bg-blue-50 text-primary-light', path('patchlevel_event_sourcing_dashboard_store_show')) }}
        {{ _self.stat('Aggregates', aggregateCount, 'identification', 'bg-violet-950 light:bg-violet-50 text-secondary-light', path('patchlevel_event_sourcing_dashboard_inspection_index')) }}
        {{ _self.stat('Registered events', eventCount, 'calendar', 'bg-cyan-950 light:bg-cyan-50 text-tertiary-light', path('patchlevel_event_sourcing_dashboard_event_index')) }}
        {{ _self.stat('Subscriptions', subscriptionCount, 'video-camera', 'bg-blue-950 light:bg-blue-50 text-primary-light', path('patchlevel_event_sourcing_dashboard_subscription_show')) }}
    </div>

    <div class="mt-10">
        {{ ui.section_title('Subscription health') }}
        <p class="mt-1 text-sm text-gray-400 light:text-slate-500">
            {% if subscriptionStatuses.error + subscriptionStatuses.failed > 0 %}
                Some subscriptions stopped processing events. Open the red ones first.
            {% else %}
                No subscription is in an error state.
            {% endif %}
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
            {% for status, count in subscriptionStatuses %}
                {% set tone = count == 0 ? 'gray' : ui.status_tone(status)|trim %}
                {% set tones = {
                    green: 'border-green-900 bg-green-950 text-green-300 light:border-green-200 light:bg-green-50 light:text-green-800',
                    yellow: 'border-amber-900 bg-amber-950 text-amber-200 light:border-amber-200 light:bg-amber-50 light:text-amber-800',
                    red: 'border-red-900 bg-red-950 text-red-300 light:border-red-200 light:bg-red-50 light:text-red-800',
                    blue: 'border-blue-900 light:border-blue-200 bg-blue-950 light:bg-blue-50 text-primary-light',
                    gray: 'border-slate-700 bg-slate-800 text-gray-500 light:border-slate-200 light:bg-transparent light:text-slate-400',
                } %}
                <a href="{{ path('patchlevel_event_sourcing_dashboard_subscription_show', { status: status }) }}"
                   class="{{ tones[tone] }} inline-flex items-center gap-x-2 rounded-lg border px-3 py-1.5 text-sm font-medium capitalize transition-colors hover:brightness-125 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light light:hover:brightness-95">
                    {{ status }}
                    <span class="font-mono text-base tabular-nums">{{ count }}</span>
                </a>
            {% endfor %}
        </div>
    </div>

    <div class="mt-10">
        <div class="flex items-end justify-between gap-4">
            {{ ui.section_title('Latest events') }}
            <a href="{{ path('patchlevel_event_sourcing_dashboard_store_show') }}"
               class="inline-flex items-center gap-1 rounded text-sm font-medium text-primary-light transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-light light:hover:text-primary">
                Open the store {{ heroicon('arrow-right', 'h-4 w-4') }}
            </a>
        </div>

        <div class="relative mt-4 overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900 light:border-slate-200 light:bg-white light:shadow-sm">
            {% set td = 'whitespace-nowrap px-4 py-3 text-sm text-gray-300 light:text-slate-600' %}
            <table class="min-w-full divide-y divide-slate-800 light:divide-slate-200">
                <thead class="bg-slate-800 light:bg-slate-50">
                <tr>
                    {% if eventsourcing_uses_stream_store() %}
                        {{ ui.th('Stream') }}
                    {% else %}
                        {{ ui.th('Aggregate') }}
                        {{ ui.th('ID') }}
                    {% endif %}
                    {{ ui.th('Playhead', 'right') }}
                    {{ ui.th('Event') }}
                    {{ ui.th('Recorded on') }}
                </tr>
                </thead>
                <tbody class="divide-y divide-slate-800 light:divide-slate-100">
                {% for message in messages %}
                    <tr class="transition-colors hover:bg-slate-800 light:hover:bg-slate-50">
                        {% if eventsourcing_uses_stream_store() %}
                            <td class="{{ td }} group/parent font-medium text-white light:text-slate-900">
                                {{ eventsourcing_stream_name(message) }}
                                {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_inspection_stream', { stream: eventsourcing_stream_name(message) }) ~ '#' ~ eventsourcing_playhead(message), 'identification', 'Inspect stream') }}
                            </td>
                        {% else %}
                            <td class="{{ td }} group/parent font-medium text-white light:text-slate-900">
                                {{ eventsourcing_aggregate_name(message) }}
                                {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_store_show', { aggregate: eventsourcing_aggregate_name(message) }), 'funnel', 'Filter by aggregate') }}
                            </td>
                            <td class="{{ td }} group/parent font-mono text-xs" title="{{ eventsourcing_aggregate_id(message) }}">
                                {{ eventsourcing_short_id(eventsourcing_aggregate_id(message)) }}
                                {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_inspection_show', { aggregateName: eventsourcing_aggregate_name(message), aggregateId: eventsourcing_aggregate_id(message) }) ~ '#' ~ eventsourcing_playhead(message), 'identification', 'Inspect aggregate') }}
                            </td>
                        {% endif %}
                        <td class="{{ td }} text-right font-mono text-xs tabular-nums">{{ eventsourcing_playhead(message) }}</td>
                        <td class="{{ td }} group/parent">
                            {{ eventsourcing_event_name(message) }}
                            {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_event_index', { name: eventsourcing_event_name(message) }) ~ '#' ~ eventsourcing_event_name(message), 'calendar', 'Show event definition') }}
                        </td>
                        <td class="{{ td }} font-mono text-xs tabular-nums">{{ eventsourcing_recorded_on(message) ? eventsourcing_recorded_on(message)|date('Y-m-d H:i:s') : '-' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">{{ ui.empty('inbox', 'No events recorded yet', 'Events show up here as soon as your application stores them.') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% macro stat(label, value, icon, tile, url) %}
    <a href="{{ url }}"
       class="group flex items-center justify-between gap-4 bg-slate-900 p-5 transition-colors hover:bg-slate-800 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary-light light:bg-white light:hover:bg-slate-50">
        <div class="min-w-0">
            <div class="truncate text-sm text-gray-400 light:text-slate-500">{{ label }}</div>
            <div class="mt-1 font-mono text-3xl font-semibold tabular-nums text-white light:text-slate-900">{{ value }}</div>
        </div>
        <div class="{{ tile }} flex h-11 w-11 shrink-0 items-center justify-center rounded-xl transition-transform group-hover:scale-105 motion-reduce:transition-none" aria-hidden="true">
            {{ heroicon(icon, 'h-5 w-5') }}
        </div>
    </a>
{% endmacro %}
