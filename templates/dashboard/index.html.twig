{% extends '@PatchlevelEventSourcingDashboard/layout.html.twig' %}

{% block content %}
    <div class="px-4 sm:px-6 lg:px-8">

        <!-- Headline -->
        <div class="text-2xl font-bold mb-8">
            Dashboard
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {{ _self.stat_card(
                "Events in store",
                messageCount,
                "circle-stack",
                path('patchlevel_event_sourcing_dashboard_store_show')
            ) }}
            {{ _self.stat_card(
                "Aggregates",
                aggregateCount,
                "identification",
                path('patchlevel_event_sourcing_dashboard_inspection_index')
            ) }}
            {{ _self.stat_card(
                "Registered events",
                eventCount,
                "calendar",
                path('patchlevel_event_sourcing_dashboard_event_index')
            ) }}
            {{ _self.stat_card(
                "Subscriptions",
                subscriptionCount,
                "video-camera",
                path('patchlevel_event_sourcing_dashboard_subscription_show')
            ) }}
        </div>

        <!-- Subscription health -->
        <div class="mt-10">
            <div class="text-base font-semibold leading-6 text-gray-900">
                Subscription health
            </div>

            <div class="mt-4 flex flex-wrap gap-3">
                {% for status, count in subscriptionStatuses %}
                    <a href="{{ path('patchlevel_event_sourcing_dashboard_subscription_show', { status: status }) }}"
                       class="{{ _self.status_classes(status, count) }} inline-flex items-center gap-x-2 rounded-md px-3 py-2 text-base font-medium capitalize ring-1 ring-inset">
                        {{ status }}
                        <span class="text-xl font-bold tabular-nums">{{ count }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>

        <!-- Latest events -->
        <div class="mt-10 flow-root">
            <div class="flex items-center justify-between">
                <div class="text-base font-semibold leading-6 text-gray-900">
                    Latest events
                </div>
                <a href="{{ path('patchlevel_event_sourcing_dashboard_store_show') }}"
                   class="text-sm font-semibold text-indigo-600 hover:text-indigo-500">
                    View all
                </a>
            </div>

            <div class="-mx-4 -my-2 mt-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
                <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                    <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                        <table class="min-w-full divide-y divide-gray-300">
                            <thead class="bg-gray-50">
                            <tr>
                                {% if eventsourcing_uses_stream_store() %}
                                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">
                                        Stream
                                    </th>
                                {% else %}
                                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">
                                        Aggregate
                                    </th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">ID
                                    </th>
                                {% endif %}
                                <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">
                                    Playhead
                                </th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
                                    Event
                                </th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
                                    Recorded On
                                </th>
                            </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 bg-white">
                            {% for message in messages %}
                                <tr>
                                    {% if eventsourcing_uses_stream_store() %}
                                        <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-500 sm:pl-6 group/parent">
                                            {{ eventsourcing_stream_name(message) }}
                                            <a href="{{ path('patchlevel_event_sourcing_dashboard_inspection_stream', { stream: eventsourcing_stream_name(message) }) }}#{{ eventsourcing_playhead(message) }}"
                                               class="text-gray-500 hover:text-gray-900 invisible group-hover/parent:visible">
                                                {{ heroicon('identification', 'h-5 w-5 inline') }}
                                            </a>
                                        </td>
                                    {% else %}
                                        <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-500 sm:pl-6 group/parent">
                                            {{ eventsourcing_aggregate_name(message) }}
                                            <a href="{{ path('patchlevel_event_sourcing_dashboard_store_show', { aggregate: eventsourcing_aggregate_name(message) }) }}"
                                               class="text-gray-500 hover:text-gray-900 invisible group-hover/parent:visible">
                                                {{ heroicon('funnel', 'h-5 w-5 inline') }}
                                            </a>
                                        </td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 group/parent"
                                            title="{{ eventsourcing_aggregate_id(message) }}">
                                            {{ eventsourcing_short_id(eventsourcing_aggregate_id(message)) }}
                                            <a href="{{ path('patchlevel_event_sourcing_dashboard_inspection_show', { aggregateName: eventsourcing_aggregate_name(message), aggregateId: eventsourcing_aggregate_id(message) }) }}#{{ eventsourcing_playhead(message) }}"
                                               class="text-gray-500 hover:text-gray-900 invisible group-hover/parent:visible">
                                                {{ heroicon('identification', 'h-5 w-5 inline') }}
                                            </a>
                                        </td>
                                    {% endif %}

                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 text-right">{{ eventsourcing_playhead(message) }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 group/parent">
                                        {{ eventsourcing_event_name(message) }}
                                        <a href="{{ path('patchlevel_event_sourcing_dashboard_event_index', { name: eventsourcing_event_name(message) }) }}#{{ eventsourcing_event_name(message) }}"
                                           class="text-gray-500 hover:text-gray-900 invisible group-hover/parent:visible">
                                            {{ heroicon('calendar', 'h-5 w-5 inline') }}
                                        </a>
                                    </td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ eventsourcing_recorded_on(message) ? eventsourcing_recorded_on(message)|date('Y-m-d H:i:s') : '-' }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-sm text-gray-500">No events found</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% macro stat_card(label, value, icon, url) %}
    <a href="{{ url }}"
       class="flex items-center gap-x-4 rounded-lg bg-white px-4 py-5 shadow ring-1 ring-black ring-opacity-5 hover:bg-gray-50">
        <div class="rounded-md bg-indigo-600 p-3">
            {{ heroicon(icon, 'h-6 w-6 text-white') }}
        </div>
        <div>
            <div class="text-sm font-medium text-gray-500">{{ label }}</div>
            <div class="text-2xl font-semibold text-gray-900">{{ value }}</div>
        </div>
    </a>
{% endmacro %}

{% macro status_classes(status, count) %}
    {%- if count == 0 -%}
        bg-white text-gray-500 ring-gray-300
    {%- elseif status in ['error', 'failed'] -%}
        bg-red-50 text-red-700 ring-red-600/20
    {%- elseif status in ['paused', 'detached'] -%}
        bg-yellow-50 text-yellow-800 ring-yellow-600/20
    {%- elseif status == 'active' -%}
        bg-green-50 text-green-700 ring-green-600/20
    {%- else -%}
        bg-gray-50 text-gray-600 ring-gray-500/10
    {%- endif -%}
{% endmacro %}
