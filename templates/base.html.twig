<!DOCTYPE html>
<html lang="en" data-theme="dark" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %}Event Sourcing Dashboard</title>
    {# Runs before paint so the page never flashes the wrong theme or width. Stored preferences win, otherwise the OS decides the theme. #}
    <script>(function(){try{var d=document.documentElement;var t=localStorage.getItem('patchlevel-dashboard-theme');var l=t==='light'||(t!=='dark'&&window.matchMedia('(prefers-color-scheme: light)').matches);d.setAttribute('data-theme',l?'light':'dark');if(localStorage.getItem('patchlevel-dashboard-width')==='full'){d.setAttribute('data-width','full');}}catch(e){}})();</script>
    <link rel="preload" href="{{ asset('bundles/patchleveleventsourcingdashboard/fonts/InterVariable.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('bundles/patchleveleventsourcingdashboard/build/app.css') }}" />
    <script src="{{ asset('bundles/patchleveleventsourcingdashboard/build/app.js') }}" defer></script>
    <link rel="icon" type="image/png" sizes="48x48" href="{{ asset('bundles/patchleveleventsourcingdashboard/favicon-48x48.png') }}" />
    <link rel="icon" type="image/png" sizes="72x72" href="{{ asset('bundles/patchleveleventsourcingdashboard/favicon-72x72.png') }}" />
    <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('bundles/patchleveleventsourcingdashboard/favicon-96x96.png') }}" />
    <link rel="icon" type="image/png" sizes="128x128" href="{{ asset('bundles/patchleveleventsourcingdashboard/favicon-128x128.png') }}" />
    <link rel="icon" type="image/png" sizes="144x144" href="{{ asset('bundles/patchleveleventsourcingdashboard/favicon-144x144.png') }}" />
    <link rel="icon" type="image/png" sizes="152x152" href="{{ asset('bundles/patchleveleventsourcingdashboard/favicon-152x152.png') }}" />
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('bundles/patchleveleventsourcingdashboard/favicon-192x192.png') }}" />
    <link rel="icon" type="image/png" sizes="384x384" href="{{ asset('bundles/patchleveleventsourcingdashboard/favicon-384x384.png') }}" />
    <link rel="icon" type="image/png" sizes="512x512" href="{{ asset('bundles/patchleveleventsourcingdashboard/favicon-512x512.png') }}" />
</head>
<body class="h-full">
{% block body %}{% endblock %}
</body>
</html>
