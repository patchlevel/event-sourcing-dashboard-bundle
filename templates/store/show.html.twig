{% extends '@PatchlevelEventSourcingDashboard/layout.html.twig' %}
{% import '@PatchlevelEventSourcingDashboard/components.html.twig' as ui %}

{% block title %}Store · {% endblock %}

{% block content %}
    {% set query = app.request.query %}
    {% set filtered = query.get('streamName') or query.get('aggregate') or query.get('aggregateId') or query.get('event') %}

    {{ ui.title('Store') }}
    {{ ui.subtitle(count ~ ' ' ~ (count == 1 ? 'event' : 'events') ~ (filtered ? ' match the filter' : ' in the store')) }}

    <form class="mt-6 flex flex-wrap items-end gap-3" action="{{ path('patchlevel_event_sourcing_dashboard_store_show') }}">
        {% if eventsourcing_uses_stream_store() %}
            <div class="w-full sm:w-80">
                {{ ui.label('streamName', 'Stream name') }}
                {{ ui.input('streamName', query.get('streamName'), 'hotel-018d233e-7906-73f1-8a0c-f76a4fdac34e') }}
            </div>
            <div class="w-full sm:w-72">
                {{ ui.label('event', 'Event') }}
                {{ ui.select('event', events, query.get('event')) }}
            </div>
        {% else %}
            <div class="w-full sm:w-52">
                {{ ui.label('aggregate', 'Aggregate') }}
                {{ ui.select('aggregate', aggregates, query.get('aggregate')) }}
            </div>
            <div class="w-full sm:w-80">
                {{ ui.label('aggregateId', 'Aggregate ID') }}
                {{ ui.input('aggregateId', query.get('aggregateId'), '018d233e-7906-73f1-8a0c-f76a4fdac34e') }}
            </div>
        {% endif %}

        <div class="flex gap-2">
            {{ ui.button_primary('Filter', 'funnel') }}
            {% if filtered %}
                {{ ui.link_secondary(path('patchlevel_event_sourcing_dashboard_store_show'), 'Clear', 'x-mark', 'Remove all filters') }}
            {% endif %}
        </div>
    </form>

    <div class="mt-6 overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 light:border-slate-200 light:bg-white light:shadow-xs">
        {% set td = 'whitespace-nowrap px-4 py-3 text-sm text-gray-300 light:text-slate-600' %}
        <div class="relative overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-800 light:divide-slate-200">
                <thead class="bg-slate-800 light:bg-slate-50">
                <tr>
                    {{ ui.th('#', 'right') }}
                    {% if eventsourcing_uses_stream_store() %}
                        {{ ui.th('Stream') }}
                    {% else %}
                        {{ ui.th('Aggregate') }}
                        {{ ui.th('ID') }}
                    {% endif %}
                    {{ ui.th('Playhead', 'right') }}
                    {{ ui.th('Event') }}
                    {{ ui.th('Recorded on') }}
                    <th scope="col" class="px-4 py-3"><span class="sr-only">Details</span></th>
                </tr>
                </thead>
                <tbody class="divide-y divide-slate-800 light:divide-slate-100">
                {% for message in messages %}
                    {% set dialog = 'message-' ~ loop.index %}
                    <tr class="transition-colors hover:bg-slate-800 hover:light:bg-slate-50">
                        <td class="{{ td }} text-right font-mono text-xs tabular-nums text-gray-500 light:text-slate-400">{{ messages.index }}</td>

                        {% if eventsourcing_uses_stream_store() %}
                            {% set stream = eventsourcing_stream_name(message) %}
                            <td class="{{ td }} group/parent font-medium text-white light:text-slate-900">
                                {{ stream }}
                                {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_store_show', { streamName: stream }), 'funnel', 'Filter by stream') }}
                                {{ ui.clipboard(stream) }}
                                {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_inspection_stream', { stream: stream }) ~ '#' ~ eventsourcing_playhead(message), 'identification', 'Inspect stream') }}
                            </td>
                        {% else %}
                            {% set aggregate = eventsourcing_aggregate_name(message) %}
                            {% set aggregateId = eventsourcing_aggregate_id(message) %}
                            <td class="{{ td }} group/parent font-medium text-white light:text-slate-900">
                                {{ aggregate }}
                                {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_store_show', { aggregate: aggregate }), 'funnel', 'Filter by aggregate') }}
                            </td>
                            <td class="{{ td }} group/parent font-mono text-xs" title="{{ aggregateId }}">
                                {{ eventsourcing_short_id(aggregateId) }}
                                {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_store_show', { aggregate: aggregate, aggregateId: aggregateId }), 'funnel', 'Filter by aggregate ID') }}
                                {{ ui.clipboard(aggregateId) }}
                                {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_inspection_show', { aggregateName: aggregate, aggregateId: aggregateId }) ~ '#' ~ eventsourcing_playhead(message), 'identification', 'Inspect aggregate') }}
                            </td>
                        {% endif %}

                        <td class="{{ td }} text-right font-mono text-xs tabular-nums">{{ eventsourcing_playhead(message) }}</td>
                        <td class="{{ td }} group/parent">
                            {{ eventsourcing_event_name(message) }}
                            {{ ui.row_action(path('patchlevel_event_sourcing_dashboard_event_index', { name: eventsourcing_event_name(message) }) ~ '#' ~ eventsourcing_event_name(message), 'calendar', 'Show event definition') }}
                        </td>
                        <td class="{{ td }} font-mono text-xs tabular-nums">{{ eventsourcing_recorded_on(message) ? eventsourcing_recorded_on(message)|date('Y-m-d H:i:s') : '-' }}</td>
                        <td class="{{ td }} text-right">
                            {{ ui.dialog_button(dialog, 'Show message details') }}

                            {% embed '@PatchlevelEventSourcingDashboard/dialog.html.twig' with { id: dialog, title: eventsourcing_event_name(message), message: message } %}
                                {% block content %}
                                    {{ include('@PatchlevelEventSourcingDashboard/store/detail.html.twig', { message: message }) }}
                                {% endblock %}
                            {% endembed %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8">
                            {% if filtered %}
                                {{ ui.empty('funnel', 'No events match this filter', 'Loosen the filter or clear it to see the whole store.') }}
                            {% else %}
                                {{ ui.empty('inbox', 'No events recorded yet', 'Events show up here as soon as your application stores them.') }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% include '@PatchlevelEventSourcingDashboard/pagination.html.twig' with { page: page, count: count, limit: limit } only %}
    </div>
{% endblock %}
