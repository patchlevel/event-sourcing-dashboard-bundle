{% extends '@PatchlevelEventSourcingDashboard/layout.html.twig' %}
{% import '@PatchlevelEventSourcingDashboard/components.html.twig' as ui %}

{% block title %}Subscriptions · {% endblock %}

{% block content %}
    {% set query = app.request.query %}
    {% set filtered = query.get('search') or query.get('group') or query.get('mode') or query.get('status') %}
    {% set modeLabels = {} %}
    {% for mode in modes|default([]) %}
        {% set modeLabels = modeLabels|merge({ (mode): mode|replace({'_': ' '}) }) %}
    {% endfor %}

    {{ ui.title('Subscriptions') }}
    {{ ui.subtitle(subscriptions|length ~ ' ' ~ (subscriptions|length == 1 ? 'subscription' : 'subscriptions') ~ (filtered ? ' match the filter' : ' registered') ~ ', ' ~ messageCount ~ ' events in the store') }}

    <form class="mt-6 flex flex-wrap items-end gap-3" action="{{ path('patchlevel_event_sourcing_dashboard_subscription_show') }}">
        <div class="w-full sm:w-52">
            {{ ui.label('search', 'Search') }}
            {{ ui.input('search', query.get('search'), 'Subscription ID') }}
        </div>
        <div class="w-full sm:w-44">
            {{ ui.label('group', 'Group') }}
            {{ ui.select('group', groups|default([]), query.get('group')) }}
        </div>
        <div class="w-full sm:w-44">
            {{ ui.label('mode', 'Run mode') }}
            {{ ui.select('mode', modes|default([]), query.get('mode'), modeLabels) }}
        </div>
        <div class="w-full sm:w-44">
            {{ ui.label('status', 'Status') }}
            {{ ui.select('status', statuses|default([]), query.get('status')) }}
        </div>
        <div class="flex gap-2">
            {{ ui.button_primary('Filter', 'funnel') }}
            {% if filtered %}
                {{ ui.link_secondary(path('patchlevel_event_sourcing_dashboard_subscription_show'), 'Clear', 'x-mark', 'Remove all filters') }}
            {% endif %}
        </div>
    </form>

    <div class="relative mt-6 overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900 light:border-slate-200 light:bg-white light:shadow-sm">
        {% set td = 'whitespace-nowrap px-4 py-3 text-sm text-gray-300 light:text-slate-600' %}
        <table class="min-w-full divide-y divide-slate-800 light:divide-slate-200">
            <thead class="bg-slate-800 light:bg-slate-50">
            <tr>
                {{ ui.th('ID') }}
                {{ ui.th('Group') }}
                {{ ui.th('Run mode') }}
                {{ ui.th('Position', 'right') }}
                {{ ui.th('Status') }}
                {{ ui.th('Updated at') }}
                <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
            </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 light:divide-slate-100">
            {% for subscription in subscriptions|sort((a, b) => a.id <=> b.id) %}
                {% set status = subscription.status.value %}
                {% set behind = subscription.position < messageCount %}
                {% set params = app.request.query.all|merge({ id: subscription.id }) %}
                {% set dialog = 'subscription-' ~ loop.index %}
                <tr class="transition-colors hover:bg-slate-800 light:hover:bg-slate-50">
                    <td class="{{ td }} font-medium text-white light:text-slate-900">{{ subscription.id }}</td>
                    <td class="{{ td }}">{{ subscription.group }}</td>
                    <td class="{{ td }}">{{ subscription.runMode.value|replace({'_': ' '}) }}</td>
                    <td class="{{ td }} text-right font-mono text-xs tabular-nums {{ behind ? 'text-amber-300 light:text-amber-700' }}"
                        {% if behind %}title="{{ messageCount - subscription.position }} events behind the store"{% endif %}>
                        {{ subscription.position }}
                        {% if behind %}<span class="text-gray-500 light:text-slate-400">/ {{ messageCount }}</span>{% endif %}
                    </td>
                    <td class="{{ td }}">{{ ui.status_badge(status) }}</td>
                    <td class="{{ td }} font-mono text-xs tabular-nums">{{ subscription.lastSavedAt|date('Y-m-d H:i:s') }}</td>
                    <td class="{{ td }}">
                        <div class="flex items-center justify-end gap-0.5">
                            {{ ui.dialog_button(dialog, 'Show subscription details') }}
                            {% if status in ['active', 'booting', 'error'] %}
                                {{ ui.icon_link(path('patchlevel_eventsourcingdashboard_subscription_pause', params), 'pause-circle', 'Pause') }}
                            {% endif %}
                            {% if status == 'new' %}
                                {{ ui.icon_link(path('patchlevel_eventsourcingdashboard_subscription_setup', params), 'power', 'Set up') }}
                            {% endif %}
                            {% if status in ['paused', 'error', 'finished', 'detached', 'failed'] %}
                                {{ ui.icon_link(path('patchlevel_eventsourcingdashboard_subscription_reactivate', params), 'play-circle', 'Reactivate') }}
                            {% endif %}
                            {% if status == 'booting' %}
                                {{ ui.icon_link(path('patchlevel_eventsourcingdashboard_subscription_boot', params), 'rocket-launch', 'Boot') }}
                            {% endif %}
                            {% if status == 'active' and behind %}
                                {{ ui.icon_link(path('patchlevel_eventsourcingdashboard_subscription_run', params), 'bolt', 'Run') }}
                            {% endif %}
                            {% if status in ['paused', 'error', 'detached', 'failed'] %}
                                {{ ui.icon_link(path('patchlevel_eventsourcingdashboard_subscription_remove', params), 'trash', 'Remove') }}
                            {% endif %}
                        </div>

                        {% embed '@PatchlevelEventSourcingDashboard/dialog.html.twig' with { id: dialog, title: subscription.id, subscription: subscription } %}
                            {% block content %}
                                {{ include('@PatchlevelEventSourcingDashboard/subscription/detail.html.twig', { subscription: subscription }) }}
                            {% endblock %}
                        {% endembed %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">
                        {% if filtered %}
                            {{ ui.empty('funnel', 'No subscriptions match this filter', 'Loosen the filter or clear it to see every subscription.') }}
                        {% else %}
                            {{ ui.empty('video-camera', 'No subscriptions registered', 'Projectors and processors appear here once the subscription engine knows them.') }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
