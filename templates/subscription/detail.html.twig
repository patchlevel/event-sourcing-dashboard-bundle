{% import '@PatchlevelEventSourcingDashboard/components.html.twig' as ui %}

<dl class="divide-y divide-slate-800 light:divide-slate-100">
    {{ ui.dl_row('ID', subscription.id) }}
    {{ ui.dl_row('Group', subscription.group) }}
    {{ ui.dl_row('Run mode', subscription.runMode.value|replace({'_': ' '})) }}
    {{ ui.dl_row('Position', subscription.position, true) }}
    <div class="grid gap-1 py-3 sm:grid-cols-3 sm:gap-4">
        <dt class="text-sm font-medium text-gray-400 light:text-slate-500">Status</dt>
        <dd class="sm:col-span-2">{{ ui.status_badge(subscription.status.value) }}</dd>
    </div>
    {{ ui.dl_row('Retry attempt', subscription.retryAttempt, true) }}
    {{ ui.dl_row('Updated at', subscription.lastSavedAt|date('Y-m-d H:i:s'), true) }}
</dl>

{% if subscription.subscriptionError %}
    <div class="space-y-4 py-3">
        {% if subscription.subscriptionError.errorContext %}
            {% for context in subscription.subscriptionError.errorContext %}
                <div class="overflow-hidden rounded-xl border border-red-900 light:border-red-200">
                    <div class="flex gap-3 bg-red-950 px-4 py-3 text-sm text-red-300 light:bg-red-50 light:text-red-800">
                        {{ heroicon('exclamation-circle', 'h-5 w-5 shrink-0') }}
                        <p class="min-w-0 wrap-break-word font-medium">{{ context.message }}</p>
                    </div>

                    {% if context.trace %}
                    <ol class="code-window divide-y divide-slate-800 rounded-none border-0 border-t border-slate-800 light:divide-slate-800 light:border-slate-800">
                        {% for step in context.trace %}
                            <li class="px-4 py-2 font-mono text-xs leading-5">
                                {% if step.class is defined %}
                                    <span class="text-gray-200" title="{{ step.class }}">
                                        <span class="text-gray-500">{{ step.class|split('\\')|slice(0, -1)|join('\\') }}\</span>{{ step.class|split('\\')|last }}{{ step.type }}<span class="text-tertiary-light light:text-[#15d3f1]">{{ step.function }}</span>
                                    </span>
                                {% else %}
                                    <span class="text-tertiary-light light:text-[#15d3f1]" title="{{ step.function }}">{{ step.function }}</span>
                                {% endif %}
                                <span class="text-gray-500" title="{{ _self.args(step.args)|escape('html_attr') }}">({% if step.args|length > 0 %}…{% endif %})</span>
                                {% if step.file is defined %}
                                    <div class="text-gray-500">{{ step.file }}:{{ step.line }}</div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                    {% endif %}
                </div>
            {% endfor %}
        {% else %}
            {{ ui.error(subscription.subscriptionError.errorMessage) }}
        {% endif %}
    </div>
{% endif %}

{% macro args(args) -%}
    {% for arg in args %}{{ _self.arg(arg) }}{% if not loop.last %}, {% endif %}{{ "\n" }}{% endfor %}
{%- endmacro %}

{% macro arg(arg) -%}
    {%- if arg[0] == 'object' -%}
        object({{ arg[1] }})
    {%- elseif arg[0] == 'resource' -%}
        resource({{ arg[1] }})
    {%- elseif arg[0] == 'string' -%}
        "{{ arg[1] }}"
    {%- elseif arg[0] == 'integer' -%}
        {{ arg[1] }}
    {%- elseif arg[0] == 'float' -%}
        {{ arg[1] }}
    {%- elseif arg[0] == 'boolean' -%}
        {{ arg[1] ? 'true' : 'false' }}
    {%- else -%}
        {{ arg[0] }}
    {%- endif -%}
{%- endmacro %}
